# Supabase (Project settings > API). The service-role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google service account with Workspace domain-wide delegation (calendar scope).
# Paste client_email and private_key from the JSON key file. Literal \n in the key is fine.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Password for /admin, 12+ characters.
ADMIN_PASSWORD=

# Public base URL, no trailing slash. Recommended once you have a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: send the bare domain to this host's page (a host slug).
DEFAULT_HOST=

# Optional: "gmail" emails the host on every new / moved / cancelled booking, from their own
# mailbox (needs the Gmail API and the gmail.send scope on the delegation entry).
HOST_EMAILS=

# Optional: key for hashing guest IPs for the rate limit. Defaults to ADMIN_PASSWORD.
IP_HASH_SALT=

# Optional: 1 removes the "Booked with open-cal by Agniverse" line under the pages.
HIDE_CREDIT=
# Any long random string. Vercel cron sends it to /api/jobs/cal-sync (Google -> bookings sync).
CRON_SECRET=
